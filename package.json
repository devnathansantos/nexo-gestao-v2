{
  "name": "nexo-gestao",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node supabase/tests/run-isolation.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:pages": "node tests/pages.mjs",
    "check:performance": "node tests/performance.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
